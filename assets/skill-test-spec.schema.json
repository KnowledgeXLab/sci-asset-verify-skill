{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sciasset.local/schemas/skill-test-spec-1.0.0.json",
  "title": "skill 资产测试说明文档 test-spec.json",
  "description": "放在 skill 资产的 validate/ 目录下，写明建议的 harness、模型与通过门槛。校验方按它执行；找不到建议的 harness 可替代但须在报告中注明；Sage A1.5 测试沿用同一 harness。",
  "type": "object",
  "required": ["harness", "model", "gate"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "harness": {
      "type": "object",
      "required": ["name", "kind"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1, "description": "建议使用的 harness 名称，如 local-cli / dsh / openai-tools / 某平台 Agent" },
        "kind": { "type": "string", "enum": ["cli", "mcp", "api", "agent", "notebook"], "description": "harness 形态" },
        "entrypoint": { "type": "string", "description": "kind=cli 时必填：相对资产目录的入口脚本" },
        "command": { "type": "string", "description": "可直接照抄的调用命令，可用 {case_id}/{out_dir} 占位" },
        "notes": { "type": "string", "description": "版本要求、依赖、已知限制" }
      }
    },
    "model": {
      "type": "object",
      "required": ["required"],
      "additionalProperties": true,
      "properties": {
        "required": { "type": "boolean", "description": "该 skill 是否需要特定大模型参与" },
        "id": { "type": "string", "description": "required=true 时必填，如 Sage-A1.5" },
        "provider": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "gate": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": true,
      "properties": {
        "type": { "type": "string", "enum": ["script", "metric"], "description": "通过门槛形式：验证脚本，或指标阈值" },
        "script": { "type": "string", "description": "type=script 时必填：相对资产目录的验证脚本，须真实存在" },
        "metrics": {
          "type": "array",
          "description": "type=metric 时必填",
          "items": {
            "type": "object",
            "required": ["id", "threshold"],
            "properties": {
              "id": { "type": "string" },
              "direction": { "type": "string", "enum": ["maximize", "minimize", "exact"] },
              "threshold": { "type": "number" },
              "notes": { "type": "string" }
            }
          }
        },
        "description": { "type": "string", "description": "一句话说明怎么算通过" }
      }
    },
    "sage": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "same_harness": { "type": "boolean", "default": true, "description": "Sage A1.5 测试是否沿用同一 harness（默认是）" },
        "notes": { "type": "string" }
      }
    }
  }
}
