{
  "schema_version": "1.0.0",
  "note": "常见 agent harness 的一次性调用方式。argv 里 {bin} 为可执行文件、{prompt} 为任务文本、{model} 为模型；sage 段描述怎么把后端换成 Sage（kind=env 注入环境变量 / kind=patch 写配置补丁 / kind=unsupported 明确不支持）。用户环境不在本表内时，用 run_skill_agent.py --harness-cmd 就地固化。 env_map：声明该 harness 需要的环境变量及其解析顺序（env: 环境变量 / bashrc: ~/.bashrc 的 export / codex-auth: ~/.codex/auth.json / cred: ~/.dsh/.credentials.yaml 的 *_API_KEY）。",
  "preference": [
    "dsh",
    "codex",
    "claude",
    "cursor",
    "gemini",
    "opencode",
    "aider"
  ],
  "harnesses": {
    "dsh": {
      "display": "DSH（DeepSeek Harness）",
      "bins": [
        "dsh"
      ],
      "argv": [
        "{bin}",
        "--profile",
        "headless",
        "--permission-mode",
        "workspace-write",
        "--",
        "{prompt}"
      ],
      "notes": "headless profile，一次性回答后退出；模型由 profile 的 agent-default-model 决定",
      "sage": {
        "kind": "patch",
        "provider": "inkstone"
      }
    },
    "codex": {
      "display": "OpenAI Codex CLI",
      "bins": [
        "codex"
      ],
      "argv": [
        "{bin}",
        "exec",
        "--skip-git-repo-check",
        "-s",
        "workspace-write",
        "{prompt}"
      ],
      "model_flag": [
        "-m",
        "{model}"
      ],
      "notes": "codex exec 非交互；-s workspace-write 允许在 workspace 内执行。早期版本还有 --full-auto，若无此参数会被拒（0.153 实测已移除）",
      "sage": {
        "kind": "env",
        "env": {
          "OPENAI_BASE_URL": "{base_url}",
          "OPENAI_API_KEY": "{api_key}"
        }
      },
      "env_map": {
        "OPENAI_API_KEY": [
          "env:OPENAI_API_KEY",
          "codex-auth:OPENAI_API_KEY",
          "cred:DEEPSEEK_API_KEY"
        ]
      }
    },
    "claude": {
      "display": "Claude Code",
      "bins": [
        "claude"
      ],
      "argv": [
        "{bin}",
        "-p",
        "{prompt}",
        "--permission-mode",
        "bypassPermissions",
        "--add-dir",
        "{skill_dir}",
        "--add-dir",
        "{package}"
      ],
      "model_flag": [
        "--model",
        "{model}"
      ],
      "notes": "claude -p 打印模式。非交互场景必须 bypassPermissions（否则 Bash/Read 全部要审批），并用 --add-dir 把 skill 目录与资产包目录加入允许范围；两者由 {skill_dir}/{package} 占位符注入。",
      "sage": {
        "kind": "env",
        "env": {
          "ANTHROPIC_BASE_URL": "{base_url}",
          "ANTHROPIC_AUTH_TOKEN": "{api_key}",
          "ANTHROPIC_MODEL": "{model}"
        }
      },
      "env_map": {
        "ANTHROPIC_BASE_URL": [
          "env:ANTHROPIC_BASE_URL",
          "bashrc:ANTHROPIC_BASE_URL"
        ],
        "ANTHROPIC_AUTH_TOKEN": [
          "env:ANTHROPIC_AUTH_TOKEN",
          "bashrc:ANTHROPIC_AUTH_TOKEN"
        ]
      }
    },
    "cursor": {
      "display": "Cursor CLI",
      "bins": [
        "agent",
        "cursor-agent",
        "cursor"
      ],
      "argv": [
        "{bin}",
        "-p",
        "--force",
        "--output-format",
        "text",
        "{prompt}"
      ],
      "notes": "Cursor CLI 的 agent -p（headless）；--force 跳过审批。鉴权用 CURSOR_API_KEY（或先 `agent login`）；团队若关闭 headless 模式，-p 会在发送前直接报错。安装：curl https://cursor.com/install -fsS | bash",
      "env_map": {
        "CURSOR_API_KEY": [
          "env:CURSOR_API_KEY",
          "bashrc:CURSOR_API_KEY"
        ]
      },
      "sage": {
        "kind": "unsupported",
        "why": "Cursor 只连自家后端，无法指向自定义 base_url"
      }
    },
    "gemini": {
      "display": "Gemini CLI",
      "bins": [
        "gemini"
      ],
      "argv": [
        "{bin}",
        "-p",
        "{prompt}",
        "--yolo"
      ],
      "model_flag": [
        "-m",
        "{model}"
      ],
      "notes": "gemini -p 非交互；--yolo 自动批准工具调用",
      "sage": {
        "kind": "env",
        "env": {
          "GOOGLE_GEMINI_BASE_URL": "{base_url}"
        }
      }
    },
    "opencode": {
      "display": "OpenCode",
      "bins": [
        "opencode"
      ],
      "argv": [
        "{bin}",
        "run",
        "--title",
        "资产包核验",
        "--auto",
        "{model}",
        "{prompt}"
      ],
      "model_flag": [
        "--model",
        "{model}"
      ],
      "notes": "opencode run（非交互）。必须 --title（否则用默认模型生成标题，provider 不可达时卡死）与 --auto（否则等审批挂住）；子进程需同步 PWD。模型默认用 ~/.config/opencode/opencode.json 的 model，需要指定时传 {model}（为空则自动去掉该参数）。凭证按 env_map 注入 OPENAI_API_KEY。",
      "sage": {
        "kind": "env",
        "env": {
          "OPENAI_BASE_URL": "{base_url}",
          "OPENAI_API_KEY": "{api_key}"
        }
      },
      "env_map": {
        "OPENAI_API_KEY": [
          "env:OPENAI_API_KEY",
          "bashrc:OPENAI_API_KEY",
          "codex-auth:OPENAI_API_KEY",
          "cred:DEEPSEEK_API_KEY"
        ]
      }
    },
    "aider": {
      "display": "Aider",
      "bins": [
        "aider"
      ],
      "argv": [
        "{bin}",
        "--yes",
        "--no-auto-commits",
        "--exit",
        "--message",
        "{prompt}"
      ],
      "model_flag": [
        "--model",
        "{model}"
      ],
      "notes": "aider --message 单轮后退出",
      "sage": {
        "kind": "env",
        "env": {
          "OPENAI_API_BASE": "{base_url}",
          "OPENAI_API_KEY": "{api_key}"
        }
      }
    }
  }
}
