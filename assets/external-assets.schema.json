{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sciasset.local/schemas/external-assets-1.0.0.json",
  "title": "外部资产引用清单 external_assets.json",
  "description": "任务包根目录下的可选文件：声明包内未随附、需平台按资产编号解析的外部资产。（v1.2 起不再包含 task_id）",
  "type": "object",
  "required": [
    "schema_version",
    "assets"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "asset_version",
          "target_path"
        ],
        "additionalProperties": true,
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^sciasset://[A-Za-z0-9][A-Za-z0-9._-]*/[a-z0-9][a-z0-9-]*/(data|tool|model|environment|skill|task|trajectory|benchmark)/[a-z0-9][a-z0-9._-]*$",
            "description": "四段格式，须与资产清单登记一致，不含版本号"
          },
          "asset_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][0-9A-Za-z.-]+)?$"
          },
          "target_path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*\\.\\.)(?!.*//)[^\\s].*$",
            "description": "相对任务包根的 POSIX 路径，不得绝对路径、不得含 .."
          },
          "media_type": {
            "type": "string",
            "description": "目录型资产填 inode/directory"
          },
          "required": {
            "type": "boolean",
            "default": true,
            "description": "可不填，缺省视为 true（资产缺失即任务启动失败）；false 时缺失不阻断，对应分项不计分"
          },
          "license": {
            "type": "string"
          },
          "access": {
            "type": "string"
          }
        }
      }
    }
  }
}
